scripts/manim/_build/
scripts/manim/**/__pycache__/
# JPL DE441（3 GB，仅本地验证用，不入库；下载见 vendor/jpl/de441/README.md）
vendor/jpl/de441/*.bsp
# JPL DE431（3.4 GB，Morrison–Stephenson 2016/2021 ΔT 所配历表，仅本地验证用，不入库；见 vendor/jpl/de431/README.md）
vendor/jpl/de431/*.bsp
# Hipparcos 主表原版（53 MB，只用于生成 data/stars/hipparcos_bright.csv；下载见 vendor/hipparcos/README.md）
vendor/hipparcos/I_239/hip_main.dat
# 维基文库原文缓存（scripts/sky_culture/lunar_mansions.py 自动下载）
scripts/sky_culture/_cache/

# Python 字节码缓存
**/__pycache__/

# 点校本二十四史（本地参考，体积大，不入库；需要的页单独摘录）
